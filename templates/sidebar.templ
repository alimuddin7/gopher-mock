package templates

import (
	"github.com/templui/templui/components/sidebar"
)

templ Sidebar() {
	@sidebar.Sidebar(sidebar.Props{
		Variant:     sidebar.VariantSidebar,
		Collapsible: sidebar.CollapsibleIcon,
	}) {
		// ── Header: Branding + Actions + Search ──────────────────────
		@sidebar.Header() {
			@sidebar.Menu() {
				@sidebar.MenuItem() {
					@sidebar.MenuButton(sidebar.MenuButtonProps{
						Tooltip: "GopherMock",
					}) {
						<i class="ri-braces-line text-primary"></i>
						<span class="font-semibold">GopherMock</span>
					}
				}
			}
			<div class="px-2 mt-2 space-y-2">
				<div class="flex justify-between items-center">
					<span class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">Configurations</span>
					<div class="flex gap-1">
						<button
							x-show="selectedIndices.length > 0"
							@click="deleteSelectedConfigs()"
							class="p-1 rounded-md text-destructive hover:bg-destructive/10 transition-colors"
							title="Delete Selected">
							<i class="ri-delete-bin-7-line text-xs"></i>
						</button>
						<button
							@click="addNewConfig()"
							class="p-1 rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
							title="Add Configuration">
							<i class="ri-add-line text-xs"></i>
						</button>
					</div>
				</div>
				<div class="relative">
					<i class="ri-search-line absolute left-2.5 top-1/2 -translate-y-1/2 text-muted-foreground text-xs pointer-events-none"></i>
					<input
						type="text"
						placeholder="Search mocks..."
						class="w-full bg-background border border-input rounded-md py-1.5 pl-8 pr-3 text-xs text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring transition-all"
						x-model="searchQuery"/>
				</div>
			</div>
		}

		// ── Content: Dynamic config list ──────────────────────────────
		@sidebar.Content() {
			<div class="px-2 py-1 flex justify-between items-center">
				<label class="flex items-center gap-2 cursor-pointer group">
					<input
						type="checkbox"
						class="w-3.5 h-3.5 rounded border-input bg-background text-primary focus:ring-ring"
						:checked="isAllSelected"
						@change="toggleSelectAll()"/>
					<span class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground group-hover:text-foreground transition-colors">Select All</span>
				</label>
				<div
					class="px-2 py-0.5 rounded-md bg-secondary text-[10px] font-bold text-secondary-foreground"
					x-text="filteredConfigs.length"></div>
			</div>

			<ul class="space-y-0.5 px-1 pb-2">
				// ── Root-level configs ────────────────────────────────
				<template x-for="cfg in (groupedConfigs.rootConfigs || [])" :key="cfg.originalIndex">
					<li class="relative group/item">
						<div
							class="flex items-center rounded-md overflow-hidden transition-all"
							:class="{ 'bg-accent text-accent-foreground': selectedIndex === cfg.originalIndex, 'hover:bg-accent/50': selectedIndex !== cfg.originalIndex }">
							<div class="pl-2 pr-1">
								<input
									type="checkbox"
									class="w-3 h-3 rounded border-input bg-background text-primary focus:ring-ring"
									:checked="selectedIndices.includes(cfg.originalIndex)"
									@change="toggleSelection(cfg.originalIndex)"/>
							</div>
							<a
								@click="selectConfig(cfg.originalIndex)"
								class="flex-1 flex items-center gap-2 py-1.5 pl-2 pr-7 cursor-pointer overflow-hidden">
								<div
									:class="getMethodBadgeClass(cfg.method)"
									class="px-1.5 py-0.5 rounded font-bold font-mono text-[8px] min-w-[34px] text-center uppercase border border-current/20">
									<span x-text="cfg.method"></span>
								</div>
								<div class="flex flex-col flex-1 min-w-0">
									<span class="truncate text-xs font-semibold" x-text="cfg.name" :title="cfg.name"></span>
									<span class="truncate text-[9px] opacity-40 font-mono" x-text="cfg.path" :title="cfg.path"></span>
								</div>
							</a>
							<button
								type="button"
								@click.stop="duplicateConfig(cfg.originalIndex)"
								class="absolute right-1.5 p-1 text-muted-foreground hover:text-foreground opacity-0 group-hover/item:opacity-100 transition-opacity">
								<i class="ri-file-copy-line text-xs"></i>
							</button>
						</div>
					</li>
				</template>

				// ── Grouped configs (folders) ─────────────────────────
				<template x-for="groupItem in (groupedConfigs.tree || [])" :key="groupItem.fullPath">
					<div x-data="{ group: groupItem }">
						<li class="mb-0.5">
							<details :open="searchQuery.length > 0 || true" class="group/details">
								<summary class="py-1.5 px-2 hover:bg-accent/50 rounded-md text-muted-foreground font-medium transition-all group-open/details:text-foreground flex items-center gap-1 cursor-pointer list-none">
									<i class="ri-arrow-right-s-line text-sm opacity-60 transition-transform group-open/details:rotate-90"></i>
									<i class="ri-folder-2-line text-sm opacity-60"></i>
									<span x-text="group.name" class="truncate flex-1 ml-0.5 text-xs"></span>
								</summary>
								<ul class="mt-0.5 ml-3 border-l border-border pl-2 space-y-0.5">
									<template x-for="cfg in group.configs" :key="cfg.originalIndex">
										<li class="relative group/item">
											<div
												class="flex items-center rounded-md overflow-hidden transition-all"
												:class="{ 'bg-accent text-accent-foreground': selectedIndex === cfg.originalIndex, 'hover:bg-accent/50': selectedIndex !== cfg.originalIndex }">
												<div class="pl-2 pr-1">
													<input
														type="checkbox"
														class="w-3 h-3 rounded border-input bg-background text-primary focus:ring-ring"
														:checked="selectedIndices.includes(cfg.originalIndex)"
														@change="toggleSelection(cfg.originalIndex)"/>
												</div>
												<a
													@click="selectConfig(cfg.originalIndex)"
													class="flex-1 flex items-center gap-2 py-1.5 pl-2 pr-7 cursor-pointer overflow-hidden">
													<div
														:class="getMethodBadgeClass(cfg.method)"
														class="px-1.5 py-0.5 rounded font-bold font-mono text-[8px] min-w-[34px] text-center uppercase border border-current/20">
														<span x-text="cfg.method"></span>
													</div>
													<div class="flex flex-col flex-1 min-w-0">
														<span class="truncate text-xs font-semibold" x-text="cfg.name" :title="cfg.name"></span>
														<span class="truncate text-[9px] opacity-40 font-mono" x-text="cfg.path" :title="cfg.path"></span>
													</div>
												</a>
											</div>
										</li>
									</template>
								</ul>
							</details>
						</li>
					</div>
				</template>
			</ul>
		}

		// ── Footer ────────────────────────────────────────────────────
		@sidebar.Footer() {
			@sidebar.Menu() {
				@sidebar.MenuItem() {
					@sidebar.MenuButton(sidebar.MenuButtonProps{
						Tooltip: "Version",
					}) {
						<i class="ri-information-line text-muted-foreground"></i>
						<span class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground opacity-70">GopherMock V2.1</span>
					}
				}
			}
		}
	}
}
